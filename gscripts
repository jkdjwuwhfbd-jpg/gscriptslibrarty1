	self._y = 8
	self._open = false
	self._height = 0

	local win = Instance.new("Frame")
	win.Name = "window"
	win.Size = UDim2.new(0, 220, 0, 42)
	win.Position = UDim2.new(0.5, -110, 0.05, 0)
