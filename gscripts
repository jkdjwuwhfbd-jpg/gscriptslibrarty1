	win.BorderSizePixel = 0
	win.ClipsDescendants = true
	win.Parent = gui

	Instance.new("UICorner", win).CornerRadius = UDim.new(0, 12)

	local ws = Instance.new("UIStroke", win)
	ws.Color = Color3.fromRGB(255, 255, 255)
	ws.Thickness = 1
	ws.Transparency = 0.87

	local topbar = Instance.new("Frame")
	topbar.Size = UDim2.new(1, 0, 0, 42)
	topbar.BackgroundColor3 = Color3.fromRGB(17, 17, 24)
	topbar.BorderSizePixel = 0
	topbar.ZIndex = 2
	topbar.Parent = win

	Instance.new("UICorner", topbar).CornerRadius = UDim.new(0, 12)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -48, 1, 0)
	title.Position = UDim2.new(0, 14, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = name or "gscripts"
	title.TextColor3 = Color3.fromRGB(235, 235, 245)
	title.TextSize = 14
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 3
	title.Parent = topbar

	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(0, 28, 1, 0)
	arrow.Position = UDim2.new(1, -34, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Text = "›"
	arrow.TextColor3 = Color3.fromRGB(140, 85, 255)
	arrow.TextSize = 20
	arrow.Font = Enum.Font.GothamBold
	arrow.Rotation = 90
	arrow.ZIndex = 3
	arrow.Parent = topbar

	local body = Instance.new("Frame")
	body.Name = "body"
	body.Size = UDim2.new(1, 0, 1, -42)
	body.Position = UDim2.new(0, 0, 0, 42)
	body.BackgroundTransparency = 1
	body.Parent = win

	self.win = win
	self.body = body

	draggable(win, topbar)

	local clickzone = Instance.new("TextButton")
	clickzone.Size = UDim2.new(1, 0, 1, 0)
	clickzone.BackgroundTransparency = 1
	clickzone.Text = ""
	clickzone.ZIndex = 4
	clickzone.Parent = topbar

	clickzone.MouseButton1Click:Connect(function()
		self._open = not self._open
		if self._open then
			tw(win, {Size = UDim2.new(0, 220, 0, 42 + self._height)}, 0.3)
			tw(arrow, {Rotation = 270}, 0.25)
		else
			tw(win, {Size = UDim2.new(0, 220, 0, 42)}, 0.3)
			tw(arrow, {Rotation = 90}, 0.25)
		end
	end)

	return self
end

function lib:_sync()
	self._height = self._y + 8
	if self._open then
		self.win.Size = UDim2.new(0, 220, 0, 42 + self._height)
	end
end

function lib:Button(text, fn)
	local y = self._y
	self._y = self._y + 40

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -18, 0, 32)
	btn.Position = UDim2.new(0, 9, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(215, 215, 230)
	btn.TextSize = 13
	btn.Font = Enum.Font.Gotham
	btn.AutoButtonColor = false
	btn.Parent = self.body

	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local bs = Instance.new("UIStroke", btn)
	bs.Color = Color3.fromRGB(255, 255, 255)
	bs.Thickness = 1
	bs.Transparency = 0.88

	local function press()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(100, 55, 200)}, 0.08)
		task.delay(0.12, function()
			tw(btn, {BackgroundColor3 = Color3.fromRGB(140, 85, 255)}, 0.12)
		end)
		if fn then task.spawn(fn) end
	end

	btn.MouseEnter:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(140, 85, 255)}, 0.15)
	end)

	btn.MouseLeave:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(22, 22, 32)}, 0.15)
	end)

	btn.MouseButton1Click:Connect(press)

	btn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then
			press()
		end
	end)

	self:_sync()
	return btn
end

function lib:Toggle(text, default, fn)
	local y = self._y
	self._y = self._y + 40
	local state = default == true

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -18, 0, 32)
	row.Position = UDim2.new(0, 9, 0, y)
	row.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
	row.BorderSizePixel = 0
	row.Parent = self.body

	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

	local rs = Instance.new("UIStroke", row)
	rs.Color = Color3.fromRGB(255, 255, 255)
	rs.Thickness = 1
	rs.Transparency = 0.88

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -54, 1, 0)
	lbl.Position = UDim2.new(0, 11, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(215, 215, 230)
	lbl.TextSize = 13
	lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 34, 0, 18)
	track.Position = UDim2.new(1, -42, 0.5, -9)
	track.BackgroundColor3 = state and Color3.fromRGB(140, 85, 255) or Color3.fromRGB(40, 40, 56)
	track.BorderSizePixel = 0
	track.Parent = row

	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 12, 0, 12)
	knob.Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = track

	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Parent = row

	local function toggle()
		state = not state
		tw(track, {BackgroundColor3 = state and Color3.fromRGB(140, 85, 255) or Color3.fromRGB(40, 40, 56)}, 0.2)
		tw(knob, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)}, 0.2)
		if fn then fn(state) end
	end

	hit.MouseButton1Click:Connect(toggle)
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then
			toggle()
		end
	end)

	self:_sync()
	return {
		Set = function(v)
			state = v
			tw(track, {BackgroundColor3 = state and Color3.fromRGB(140, 85, 255) or Color3.fromRGB(40, 40, 56)}, 0.2)
			tw(knob, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)}, 0.2)
		end,
		Get = function() return state end
	}
end

function lib:Slider(text, min, max, default, fn)
	local y = self._y
	self._y = self._y + 54
	local val = math.clamp(default or min, min, max)

	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, -18, 0, 46)
	wrap.Position = UDim2.new(0, 9, 0, y)
	wrap.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
	wrap.BorderSizePixel = 0
	wrap.Parent = self.body

	Instance.new("UICorner", wrap).CornerRadius = UDim.new(0, 8)

	local ws = Instance.new("UIStroke", wrap)
	ws.Color = Color3.fromRGB(255, 255, 255)
	ws.Thickness = 1
	ws.Transparency = 0.88

	local slbl = Instance.new("TextLabel")
	slbl.Size = UDim2.new(0.65, 0, 0, 22)
	slbl.Position = UDim2.new(0, 11, 0, 0)
	slbl.BackgroundTransparency = 1
	slbl.Text = text
	slbl.TextColor3 = Color3.fromRGB(215, 215, 230)
	slbl.TextSize = 12
	slbl.Font = Enum.Font.Gotham
	slbl.TextXAlignment = Enum.TextXAlignment.Left
	slbl.Parent = wrap

	local vlbl = Instance.new("TextLabel")
	vlbl.Size = UDim2.new(0.35, -11, 0, 22)
	vlbl.Position = UDim2.new(0.65, 0, 0, 0)
	vlbl.BackgroundTransparency = 1
	vlbl.Text = tostring(val)
	vlbl.TextColor3 = Color3.fromRGB(140, 85, 255)
	vlbl.TextSize = 12
	vlbl.Font = Enum.Font.GothamBold
	vlbl.TextXAlignment = Enum.TextXAlignment.Right
	vlbl.Parent = wrap

	local rail = Instance.new("Frame")
	rail.Size = UDim2.new(1, -22, 0, 5)
	rail.Position = UDim2.new(0, 11, 0, 30)
	rail.BackgroundColor3 = Color3.fromRGB(40, 40, 56)
	rail.BorderSizePixel = 0
	rail.Parent = wrap

	Instance.new("UICorner", rail).CornerRadius = UDim.new(1, 0)

	local pct = (val - min) / (max - min)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(pct, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(140, 85, 255)
	fill.BorderSizePixel = 0
	fill.Parent = rail

	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 14, 0, 14)
	dot.Position = UDim2.new(pct, -7, 0.5, -7)
	dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dot.BorderSizePixel = 0
	dot.Parent = rail

	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local sliding = false

	local function applyInput(pos)
		local rel = math.clamp((pos.X - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
		val = math.floor(min + (max - min) * rel)
		vlbl.Text = tostring(val)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		dot.Position = UDim2.new(rel, -7, 0.5, -7)
		if fn then fn(val) end
	end

	rail.InputBegan:Connect(function(i)
		if isTouch(i) then
			sliding = true
			applyInput(i.Position)
		end
	end)

	dot.InputBegan:Connect(function(i)
		if isTouch(i) then
			sliding = true
		end
	end)

	UserInputService.InputChanged:Connect(function(i)
		if sliding and isMoved(i) then
			applyInput(i.Position)
		end
	end)

	UserInputService.InputEnded:Connect(function(i)
		if isTouch(i) then
			sliding = false
		end
	end)

	self:_sync()
	return {
		Set = function(v)
			val = math.clamp(v, min, max)
			local r = (val - min) / (max - min)
			vlbl.Text = tostring(val)
			fill.Size = UDim2.new(r, 0, 1, 0)
			dot.Position = UDim2.new(r, -7, 0.5, -7)
		end,
		Get = function() return val end
	}
end

