	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(0, 24, 1, 0)
	arrow.Position = UDim2.new(1, -30, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Text = "›"
	arrow.TextColor3 = Color3.fromRGB(140, 85, 255)
	arrow.TextSize = 18
	arrow.Font = Enum.Font.GothamBold
	arrow.Rotation = 90
	arrow.ZIndex = 3
	arrow.Parent = topbar

	local body = Instance.new("Frame")
	body.Name = "body"
	body.Size = UDim2.new(1, 0, 1, -38)
	body.Position = UDim2.new(0, 0, 0, 38)
	body.BackgroundTransparency = 1
	body.Parent = win

	self.win = win
	self.body = body
	self._arrow = arrow

	draggable(win, topbar)

	local clickblocker = Instance.new("TextButton")
	clickblocker.Size = UDim2.new(1, 0, 1, 0)
	clickblocker.BackgroundTransparency = 1
	clickblocker.Text = ""
	clickblocker.ZIndex = 4
	clickblocker.Parent = topbar

	clickblocker.MouseButton1Click:Connect(function()
		self._open = not self._open
		if self._open then
			tw(win, {Size = UDim2.new(0, 210, 0, 38 + self._height)}, 0.3, Enum.EasingStyle.Quart)
			tw(arrow, {Rotation = 270}, 0.25)
		else
			tw(win, {Size = UDim2.new(0, 210, 0, 38)}, 0.3, Enum.EasingStyle.Quart)
			tw(arrow, {Rotation = 90}, 0.25)
		end
	end)

	return self
end

function lib:_update()
	self._height = self._y + 8
	if self._open then
		self.win.Size = UDim2.new(0, 210, 0, 38 + self._height)
	end
end

function lib:Button(text, fn)
	local y = self._y
	self._y = self._y + 36

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -16, 0, 28)
	btn.Position = UDim2.new(0, 8, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(210, 210, 225)
	btn.TextSize = 12
	btn.Font = Enum.Font.Gotham
	btn.AutoButtonColor = false
	btn.Parent = self.body

	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 7)
	bc.Parent = btn

	local bs = Instance.new("UIStroke")
	bs.Color = Color3.fromRGB(255, 255, 255)
	bs.Thickness = 1
	bs.Transparency = 0.9
	bs.Parent = btn

	btn.MouseEnter:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(140, 85, 255)}, 0.18)
		tw(bs, {Transparency = 1}, 0.18)
	end)

	btn.MouseLeave:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(20, 20, 28)}, 0.18)
		tw(bs, {Transparency = 0.9}, 0.18)
	end)

	btn.MouseButton1Down:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(100, 55, 200)}, 0.1)
	end)

	btn.MouseButton1Up:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(140, 85, 255)}, 0.1)
		if fn then
			task.spawn(fn)
		end
	end)

	self:_update()
	return btn
end

function lib:Toggle(text, default, fn)
	local y = self._y
	self._y = self._y + 36
	local state = default == true

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -16, 0, 28)
	row.Position = UDim2.new(0, 8, 0, y)
	row.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
	row.BorderSizePixel = 0
	row.Parent = self.body

	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0, 7)
	rc.Parent = row

	local rs = Instance.new("UIStroke")
	rs.Color = Color3.fromRGB(255, 255, 255)
	rs.Thickness = 1
	rs.Transparency = 0.9
	rs.Parent = row

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -52, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(210, 210, 225)
	lbl.TextSize = 12
	lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 32, 0, 16)
	track.Position = UDim2.new(1, -40, 0.5, -8)
	track.BackgroundColor3 = state and Color3.fromRGB(140, 85, 255) or Color3.fromRGB(38, 38, 52)
	track.BorderSizePixel = 0
	track.Parent = row

	local trc = Instance.new("UICorner")
	trc.CornerRadius = UDim.new(1, 0)
	trc.Parent = track

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 11, 0, 11)
	knob.Position = state and UDim2.new(1, -14, 0.5, -5.5) or UDim2.new(0, 3, 0.5, -5.5)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = track

	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(1, 0)
	kc.Parent = knob

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Parent = row

	local function setToggle(v)
		state = v
		tw(track, {BackgroundColor3 = state and Color3.fromRGB(140, 85, 255) or Color3.fromRGB(38, 38, 52)}, 0.2)
		tw(knob, {Position = state and UDim2.new(1, -14, 0.5, -5.5) or UDim2.new(0, 3, 0.5, -5.5)}, 0.2, Enum.EasingStyle.Quart)
		if fn then fn(state) end
	end

	hit.MouseButton1Click:Connect(function()
		setToggle(not state)
	end)

	self:_update()

	return {
		Set = function(v) setToggle(v) end,
		Get = function() return state end
	}
end

